    "# Feature distributions by class\n",
    "fig, axes = plt.subplots(2, 5, figsize=(20, 8))\n",
    "axes = axes.ravel()\n",
    "\n",
    "for i, feat in enumerate(core_features):\n",
    "    ax = axes[i]\n",
    "    df[df['is_attack']==0][feat].hist(alpha=0.5, label='Normal', bins=30, ax=ax, density=True)\n",
    "    df[df['is_attack']==1][feat].hist(alpha=0.5, label='Attack', bins=30, ax=ax, density=True)\n",
    "    ax.set_title(feat)\n",
    "    ax.legend(fontsize=8)\n",
    "    ax.tick_params(labelsize=8)\n",
    "\n",
    "plt.suptitle(\"Feature Distributions: Normal vs Attack\", fontsize=14)\n",
