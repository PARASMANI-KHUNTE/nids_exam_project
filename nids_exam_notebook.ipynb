   "metadata": {},
   "source": [
    "# Network Intrusion Detection System (NIDS) - Complete Project Notebook\n",
    "\n",
    "**Practical Exam Preparation: Written Exam + Viva Voce**\n",
    "\n",
    "This notebook contains the complete end-to-end workflow for building a Network Intrusion Detection System using:\n",
    "- **Random Forest (Scikit-Learn)** - 99% accuracy\n",
    "- **Multi-Layer Perceptron (PyTorch)** - 90% accuracy\n",
    "\n",
    "Dataset: NSL-KDD 20% (10,000 balanced samples, 10 features, binary classification)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Environment Setup & Imports"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Install dependencies (run once)\n",
    "# !pip install pandas scikit-learn matplotlib seaborn joblib torch requests -q\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import requests\n",
    "from io import StringIO\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# ML imports\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.metrics import classification_report, confusion_matrix\n",
    "import joblib\n",
    "\n",
    "# DL imports\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.optim as optim\n",
    "\n",
    "print(\"Environment ready!\")\n",
    "print(f\"PyTorch version: {torch.__version__}\")\n",
    "print(f\"CUDA available: {torch.cuda.is_available()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Data Preparation - Download & Preprocess NSL-KDD"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Column names for NSL-KDD dataset\n",
    "col_names = [\n",
    "    'duration', 'protocol_type', 'service', 'flag', 'src_bytes', 'dst_bytes',\n",
    "    'land', 'wrong_fragment', 'urgent', 'hot', 'num_failed_logins', 'logged_in',\n",
    "    'num_compromised', 'root_shell', 'su_attempted', 'num_root', 'num_file_creations',\n",
    "    'num_shells', 'num_access_files', 'num_outbound_cmds', 'is_host_login',\n",
    "    'is_guest_login', 'count', 'srv_count', 'serror_rate', 'srv_serror_rate',\n",
    "    'rerror_rate', 'srv_rerror_rate', 'same_srv_rate', 'diff_srv_rate',\n",
    "    'srv_diff_host_rate', 'dst_host_count', 'dst_host_srv_count',\n",
    "    'dst_host_same_srv_rate', 'dst_host_diff_srv_rate',\n",
    "    'dst_host_same_src_port_rate', 'dst_host_srv_diff_host_rate',\n",
    "    'dst_host_serror_rate', 'dst_host_srv_serror_rate',\n",
    "    'dst_host_rerror_rate', 'dst_host_srv_rerror_rate', 'label', 'difficulty'\n",
    "]\n",
    "\n",
    "# 10 core numerical features\n",
    "core_features = [\n",
    "    'duration', 'src_bytes', 'dst_bytes', 'logged_in', 'count',\n",
    "    'srv_count', 'serror_rate', 'srv_serror_rate', 'same_srv_rate', 'dst_host_srv_count'\n",
    "]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def download_nsl_kdd():\n",
    "    \"\"\"Download NSL-KDD 20% dataset from GitHub\"\"\"\n",
    "    url = \"https://raw.githubusercontent.com/jmnwong/NSL-KDD-Dataset/master/KDDTrain%2B_20Percent.txt\"\n",
    "    try:\n",
    "        print(\"Downloading NSL-KDD 20% dataset...\")\n",
    "        response = requests.get(url, timeout=30)\n",
    "        response.raise_for_status()\n",
    "        df = pd.read_csv(StringIO(response.text), names=col_names)\n",
    "        print(f\"Downloaded successfully! Shape: {df.shape}\")\n",
    "        return df\n",
    "    except Exception as e:\n",
    "        print(f\"Download failed: {e}\")\n",
    "        return None\n",
    "\n",
    "def load_kddcup99_fallback():\n",
    "    \"\"\"Fallback: Load KDD Cup 99 from sklearn\"\"\"\n",
    "    from sklearn.datasets import fetch_kddcup99\n",
    "    print(\"Using sklearn fallback: fetch_kddcup99(percent10=True)...\")\n",
    "    data = fetch_kddcup99(percent10=True, as_frame=True)\n",
    "    df = data.frame\n",
    "    df.columns = col_names[:-1]  # No difficulty column\n",
    "    print(f\"Loaded fallback dataset! Shape: {df.shape}\")\n",
    "    return df\n",
    "\n",
    "def preprocess_data(df):\n",
    "    \"\"\"Preprocess: select features, create binary label, stratified sample 10K\"\"\"\n",
    "    X = df[core_features].copy()\n",
    "    y = df['label'].apply(lambda x: 0 if x == 'normal' or x == b'normal.' else 1)\n",
    "    df_clean = pd.concat([X, y.rename('is_attack')], axis=1).dropna()\n",
    "    \n",
    "    # Stratified sample 10,000 rows (5000 per class)\n",
    "    from sklearn.model_selection import train_test_split\n",
    "    df_sampled = train_test_split(df_clean, train_size=10000, \n",
    "                                   stratify=df_clean['is_attack'], \n",
    "                                   random_state=42)[0]\n",
    "    return df_sampled\n",
    "\n",
    "# Execute\n",
    "df = download_nsl_kdd()\n",
    "if df is None:\n",
    "    df = load_kddcup99_fallback()\n",
    "\n",
    "df_final = preprocess_data(df)\n",
    "df_final.to_csv(\"network_intrusion.csv\", index=False)\n",
    "\n",
    "print(f\"\\n=== Dataset Summary ===\")\n",
    "print(f\"Shape: {df_final.shape}\")\n",
    "print(f\"Features: {core_features}\")\n",
    "print(f\"\\nClass Distribution:\")\n",
    "print(df_final['is_attack'].value_counts())\n",
    "print(f\"\\nSaved to: network_intrusion.csv\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Exploratory Data Analysis"
   ]
  },
  {
